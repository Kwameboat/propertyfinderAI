# JAB Hub — Evolution API (local) — copy to .env and change secrets

SERVER_NAME=jab-hub
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

AUTHENTICATION_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_KEY
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
LANGUAGE=en

POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:CHANGE_ME_DB_PASSWORD@evolution-postgres:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=jab_hub
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=jabhub
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

CONFIG_SESSION_PHONE_CLIENT=JAB Hub
CONFIG_SESSION_PHONE_NAME=Chrome

QRCODE_LIMIT=30
QRCODE_COLOR=#175197
DEL_INSTANCE=false

LOG_LEVEL=ERROR,WARN,INFO,LOG
LOG_COLOR=true
LOG_BAILEYS=error

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

TELEMETRY_ENABLED=false

# Every new Evolution instance posts inbound events to the OpenClaw bridge
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://host.docker.internal:8787/evolution
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_QRCODE_UPDATED=false
WEBHOOK_EVENTS_MESSAGES_SET=false
WEBHOOK_EVENTS_MESSAGES_UPDATE=false
WEBHOOK_EVENTS_SEND_MESSAGE=false
WEBHOOK_EVENTS_CONTACTS_SET=false
WEBHOOK_EVENTS_CONTACTS_UPSERT=false
WEBHOOK_EVENTS_CONTACTS_UPDATE=false
WEBHOOK_EVENTS_PRESENCE_UPDATE=false
WEBHOOK_EVENTS_CHATS_SET=false
WEBHOOK_EVENTS_CHATS_UPSERT=false
WEBHOOK_EVENTS_CHATS_UPDATE=false
WEBHOOK_EVENTS_CHATS_DELETE=false
WEBHOOK_EVENTS_GROUPS_UPSERT=false
WEBHOOK_EVENTS_GROUPS_UPDATE=false
WEBHOOK_EVENTS_GROUP_PARTICIPANTS_UPDATE=false
WEBHOOK_EVENTS_LABELS_EDIT=false
WEBHOOK_EVENTS_LABELS_ASSOCIATION=false
WEBHOOK_EVENTS_CALL=false

RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
PUSHER_ENABLED=false
KAFKA_ENABLED=false
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
S3_ENABLED=false

WA_BUSINESS_TOKEN_WEBHOOK=evolution
WA_BUSINESS_URL=https://graph.facebook.com
WA_BUSINESS_VERSION=v20.0
WA_BUSINESS_LANGUAGE=en_US

# Agency Hub dashboard (contacts + campaigns) — http://127.0.0.1:3000
HUB_ADMIN_PASSWORD=CHANGE_ME_HUB_PASSWORD
JAB_HUB_PORT=3000
JAB_HUB_PUBLIC_URL=http://127.0.0.1:3000
JAB_HUB_MAX_RECIPIENTS_WARN=50
# Optional: Calendly / booking URL for the agency WhatsApp growth prompt
# JAB_HUB_BOOKING_URL=https://calendly.com/your-link
# Bridge URL Evolution should call (must match WEBHOOK_GLOBAL_URL)
JAB_HUB_BRIDGE_URL=http://host.docker.internal:8787/evolution
JAB_HUB_BRIDGE_PORT=8787
# Production: strict bridge auth + Hub secure cookies (set on VPS)
# JAB_HUB_PRODUCTION=1
# JAB_BRIDGE_TRUST_LOCAL=0
# Platform tenant session TTL (ms, default 72h)
# JAB_PLATFORM_SESSION_TTL_MS=259200000
# Cooldown between agency menu replies per customer (ms)
# JAB_AGENCY_INBOUND_COOLDOWN_MS=2000
# Hub admin login rate limit per IP per minute
# JAB_HUB_LOGIN_RATE_MAX=12
# WhatsApp typing indicator while the agent composes (on|off). Default: on
JAB_HUB_TYPING=on

# Paystack (GHS) — Finance tab / client point top-ups
# Webhook URL: {JAB_HUB_PUBLIC_URL}/api/billing/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Optional agency billing email for Paystack (otherwise auto from WhatsApp number)
JAB_HUB_BILLING_EMAIL=
# Domain for auto-generated Paystack checkout emails (must not use .local)
JAB_HUB_PAYSTACK_EMAIL_DOMAIN=customers.jabdigitalhub.com
# Optional fallback if agency instance not set in Hub Finance
# Agency WhatsApp uses unlimited AI credits (no points gate). Default: jab-whatsapp
JAB_AGENCY_INSTANCE=
# Agency WhatsApp digits (no +) for platform tenant wa.me links
JAB_AGENCY_WA_PHONE=

# Yango delivery fee quotes (optional — email integration-support@yango.com for keys)
# Without keys, the bridge uses distance-based GHS estimates (shop → buyer).
YANGO_CLID=
YANGO_APIKEY=
YANGO_CLASS=express
YANGO_FALLBACK_BASE_GHS=10
YANGO_FALLBACK_PER_KM_GHS=2.5
YANGO_FALLBACK_MIN_GHS=12

# ---------------------------------------------------------------------------
# Proactive Marketing Agent (Telegram-operated discovery + approval)
#   node scripts/proactive-marketing-agent.mjs
# ---------------------------------------------------------------------------
# Create bot with @BotFather, then message it and read your user id via /start
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to approve sends
TELEGRAM_APPROVER_IDS=
# Brave Search API key for public-web discovery (optional; /lead <url> works without it)
BRAVE_SEARCH_API_KEY=
# Free search (default): DuckDuckGo — no key needed
# Optional official free tier: Google Programmable Search (100 queries/day)
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=
# Force provider: auto | duckduckgo | brave | google
JAB_MARKETING_SEARCH_PROVIDER=auto
# Agency WhatsApp instance used for outreach (Finance agency instance)
JAB_MARKETING_INSTANCE=jab-whatsapp
# Ops alerts for handoffs / hot leads / payments (recommended — keeps Meta happy)
# Dedicated agency-leads bot (create with @BotFather; do not reuse marketing bot)
TELEGRAM_AGENCY_LEADS_BOT_TOKEN=
# Your Telegram user or group chat ID (run: node scripts/agency-leads-telegram-register.mjs)
TELEGRAM_AGENCY_LEADS_CHAT_IDS=
# Legacy aliases (optional — agency-leads vars take precedence)
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_CHAT_IDS=
# telegram | whatsapp | both | hub | off — Hub Finance can override (default both)
JAB_AGENCY_OPS_CHANNEL=both
# 0 = summary on WhatsApp only (no Hub URL in alert)
JAB_AGENCY_DIGEST_HUB_URL=0

# Meta WhatsApp Cloud API (optional direct send; Evolution Cloud instance preferred)
META_WABA_ACCESS_TOKEN=
META_WABA_PHONE_NUMBER_ID=
META_WABA_VERIFY_TOKEN=

# Keep 1 until you are ready for live WhatsApp sends
JAB_MARKETING_DRY_RUN=1
JAB_MARKETING_DAILY_CAP=3
JAB_MARKETING_COOLDOWN_DAYS=60
JAB_MARKETING_FOLLOWUP_HOURS=72
# WhatsApp ban-risk guards (Baileys / unofficial client)
# Pause ops alerts, marketing, and follow-ups on agency number (inbound AI replies still work)
JAB_AGENCY_OUTBOUND_PAUSE=1
JAB_AGENCY_FOLLOWUP=off
JAB_AGENCY_TYPING=off
JAB_HUB_TYPING=off
JAB_WA_OPS_MIN_MS=5000
JAB_WA_PROACTIVE_MIN_MS=10000
JAB_WA_PROACTIVE_DAILY_CAP=3
JAB_WA_OPS_DAILY_CAP=20
# Optional: pipe-separated custom Brave queries
# JAB_MARKETING_QUERIES=Ghana "wa.me" shop|Accra "Chat on WhatsApp"
# Auto-discovery interval ms (0 disables scheduled discovery)
JAB_MARKETING_DISCOVER_MS=3600000

# Agency Social Media Agent (own Telegram bot — do not reuse TELEGRAM_BOT_TOKEN)
TELEGRAM_SOCIAL_BOT_TOKEN=
TELEGRAM_SOCIAL_APPROVER_IDS=
JAB_SOCIAL_DRY_RUN=1
JAB_SOCIAL_BRAND_NAME=JAB Digital Hub
JAB_SOCIAL_BRAND_COLORS=#0F4C5C,#E8D5B7
JAB_SOCIAL_IMAGE_MODEL=gemini-2.5-flash-image
JAB_SOCIAL_PUBLIC_MEDIA_BASE=
GEMINI_API_KEY=
# Dar Concierge / KeyFinder AI chat model (fast + capable)
JAB_RE_GEMINI_MODEL=gemini-2.5-flash

# Market: AE (default, Dar Concierge UAE) or GH (KeyFinder Ghana at /gh)
# JAB_RE_MARKET=GH
# JAB_RE_GH_DEV_PAY=1
# Viewing PIN WhatsApp instance
# JAB_RE_WA_INSTANCE=jab-whatsapp

# UAE Real Estate Concierge (PWA at /rent)
# JAB_RE_OPENCLAW_VIA=gemini
# JAB_RE_OPENCLAW_AGENT_ID=uae-real-estate-agent
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   (client / server with RLS policies)
# SUPABASE_SECRET_KEY=sb_secret_...             (recommended for VPS cron — bypasses RLS)
# SUPABASE_DB_PASSWORD=                         (postgres role — reset in Dashboard if unknown)
# SUPABASE_ACCESS_TOKEN=sbp_...                 (Management API — https://supabase.com/dashboard/account/tokens)
# n8n Live Search RAG (SearXNG → Jina → Gemini → Supabase) — see deploy/N8N-LIVE-SEARCH.md
# Hub runs on the VPS host (systemd) — use 127.0.0.1, not host.docker.internal
# N8N_LIVE_SEARCH_WEBHOOK=http://127.0.0.1:5678/webhook/re-live-search
# N8N_LIVE_SEARCH_TIMEOUT_MS=120000

# Developer & Government Intel (live fetch from developer-sources registry)
# DEVELOPER_INTEL_TIMEOUT_MS=90000
# DEVELOPER_INTEL_MAX_URLS=3
JAB_RE_ZERO_COST_MODE=1
JAB_RE_INGEST_TOKEN=
JAB_RE_STALE_HOURS=96
JAB_RE_SCRAPE_DELAY_MS=3000
# Scale & availability (all OFF by default — existing behavior unchanged)
# JAB_RE_LIVE_CACHE_TTL_SEC=600
# JAB_RE_PORTAL_MAX_CONCURRENT=5
# JAB_RE_HIDE_UNAVAILABLE=1
# JAB_RE_VERIFY_LISTINGS=1
# JAB_RE_VERIFY_BATCH=30
# Puppeteer bulk scrape — OFF by default; does not replace HTML/Algolia cron
# JAB_RE_PUPPETEER_SCRAPE=0
# JAB_RE_PUPPETEER_SOURCES=propertyfinder_puppeteer
# JAB_RE_PUPPETEER_MAX_PAGES=3
# JAB_RE_PUPPETEER_DELAY_MS=3000
# JAB_RE_PUPPETEER_DETAIL_PAGES=0
# Apify — Property Finder primary scraper (upgrade from $0 HTML mode)
# APIFY_API_TOKEN=apify_api_xxxxxxxx
# JAB_RE_PF_SCRAPER=apify
# JAB_RE_APIFY_FREE_MODE=0
# JAB_RE_APIFY_MAX_PAGES=3
# JAB_RE_APIFY_MAX_RESULTS=100
# JAB_RE_APIFY_PF_ACTOR=benthepythondev/propertyfinder-scraper
# JAB_RE_APIFY_BAYUT_ACTOR=memo23/apify-bayut-scraper
# JAB_RE_APIFY_DUBIZZLE_ACTOR=benthepythondev/dubizzle-scraper
# JAB_RE_APIFY_EMIRATES=Dubai,Abu Dhabi
# RapidAPI — one account key works for all subscribed APIs (get from RapidAPI → My Apps → default app)
# Subscribe to: uae-real-estate3 (Bayut) + uae-real-estate-api-propertyfinder-ae-data (Property Finder)
RAPIDAPI_KEY=
# RAPIDAPI_PF_HOST=uae-real-estate-api-propertyfinder-ae-data.p.rapidapi.com
TELEGRAM_RE_LEADS_BOT_TOKEN=
TELEGRAM_RE_LEADS_APPROVER_IDS=
JAB_RE_LEADS_INSTANCE=jab-whatsapp
JAB_RE_LEADS_DRY_RUN=1
JAB_RE_LEADS_QUEUE_MS=120000

# UAE RE WhatsApp concierge (Evolution instance name or agency-line routing)
# JAB_RE_WA_INSTANCE=jab-agency-wa
# JAB_RE_WA_ON_AGENCY=1

# Free stock photos for flyers (optional — Wikimedia Commons works without keys)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# PosterMyWall developer/embed key if you use their template embed (not required for Gemini flyers)
POSTERMYWALL_API_KEY=

# Personal RAG + PA Agent (your private Telegram bot — separate from marketing/social)
TELEGRAM_PA_BOT_TOKEN=
TELEGRAM_PA_OWNER_IDS=
JAB_PA_OWNER_NAME=Boss
JAB_PA_TZ=Africa/Accra
JAB_PA_DAILY_BRIEF_HOUR=6
JAB_PA_GEMINI_MODEL=gemini-2.5-flash
JAB_PA_EMBED_MODEL=text-embedding-004
CURSOR_API_KEY=
JAB_PA_CURSOR_REPO_URL=https://github.com/Kwameboat/jab-hub.git
JAB_PA_CURSOR_BRANCH=master
JAB_PA_CURSOR_MODEL=composer-2.5
JAB_PA_CURSOR_AUTO_PR=0

# Meta app (developers.facebook.com) — OAuth + Marketing API
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_IG_USER_ID=
TIKTOK_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# n8n automation — http://127.0.0.1:5678 (local) or http://YOUR_VPS_IP:5678
# See deploy/N8N.md for Hub / Evolution integration examples.
# ---------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://127.0.0.1:5678/
N8N_TIMEZONE=Africa/Accra
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_N8N_PASSWORD
N8N_SECURE_COOKIE=false
N8N_ENCRYPTION_KEY=CHANGE_ME_N8N_ENCRYPTION_KEY

# ---------------------------------------------------------------------------
# Production VPS (24/7) — see deploy/DEPLOY.md and deploy/.env.production.example
# ---------------------------------------------------------------------------
# On Linux VPS:
#   1. Copy deploy/.env.production.example → .env
#   2. Set SERVER_URL=http://YOUR_VPS_IP:8080
#   3. Set JAB_HUB_PUBLIC_URL=http://YOUR_VPS_IP:3000
#   4. Keep WEBHOOK_GLOBAL_URL=http://host.docker.internal:8787/evolution
#   5. Start with:
#        docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml up -d
#   6. JAB_HUB_DATA_DIR=/var/lib/jab-hub  (Hub DB + product uploads)
# Do NOT use cPanel shared hosting — Docker + Node agents need a VPS.
