{
  "name": "@jab-hub/fie-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PropertyFinder Gh — standalone Ghana real-estate PWA for Vercel",
  "scripts": {
    "build": "node scripts/build-public.mjs",
    "predev": "npm run build",
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "prestart": "npm run build",
    "scrape": "node scripts/scrape-to-supabase.mjs",
    "scrape:all": "node scripts/scrape-to-supabase.mjs --all",
    "bootstrap": "node scripts/bootstrap-supabase.mjs",
    "verify": "node scripts/verify-ready.mjs",
    "verify:strict": "node scripts/verify-ready.mjs --strict"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
