# FIE AI standalone (Vercel / local)
JAB_RE_MARKET=GH
JAB_FIE_STANDALONE=1

# Gemini (required for chat + voice)
GEMINI_API_KEY=

# Supabase listing store (required for live scrapes on Vercel)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Protect scrape / ingest endpoints
JAB_RE_INGEST_TOKEN=change-me-long-random
# Vercel Cron also sends: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Scrape tuning (cron runs one tick every 2h by default)
# JAB_FIE_SCRAPE_SOURCES=ghanapropertycentre,meqasa
# JAB_RE_SCRAPE_EMIRATES=Accra,Kumasi,Tema
# JAB_FIE_SCRAPE_MAX_PAGES=1
# JAB_FIE_SCRAPE_TICK_MINUTES=120
# Optional Jiji (needs a reachable FlareSolverr — usually not on Vercel)
# FLARESOLVERR_URL=http://127.0.0.1:8191

# Paystack viewing fee (GH₵100). Without keys, demo PIN mode is used locally.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# JAB_RE_GH_DEV_PAY=1

# Optional WhatsApp CTA on the PWA
JAB_RE_WA_PHONE=23324xxxxxxx

# Local data dir (Vercel uses /tmp/fie-ai)
# JAB_HUB_DATA_DIR=.fie-ai-data
