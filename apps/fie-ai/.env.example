# FIE AI standalone (Vercel / local)
JAB_RE_MARKET=GH
JAB_FIE_STANDALONE=1

# Gemini (required for chat + voice)
GEMINI_API_KEY=

# Optional: production listing store (otherwise SQLite seed in /tmp)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack viewing fee (GH₵100). Without keys, JAB_RE_GH_DEV_PAY=1 unlocks demo PIN.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# JAB_RE_GH_DEV_PAY=1

# Optional WhatsApp CTA on the PWA
JAB_RE_WA_PHONE=23324xxxxxxx

# Local data dir (Vercel uses /tmp/fie-ai)
# JAB_HUB_DATA_DIR=.fie-ai-data
