[Unit]
Description=JAB Hub — verify stale RE listing availability
After=network.target jab-hub-dashboard.service

[Service]
Type=oneshot
User=jabhub
WorkingDirectory=/opt/jab-hub
EnvironmentFile=-/opt/jab-hub/.env
ExecStart=/usr/bin/node /opt/jab-hub/scripts/re-verify-listings.mjs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
