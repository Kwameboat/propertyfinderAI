[Unit]
Description=JAB Hub Evolution ↔ OpenClaw bridge
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=jabhub
Group=jabhub
WorkingDirectory=/opt/jab-hub
EnvironmentFile=/opt/jab-hub/.env
Environment=JAB_HUB_DATA_DIR=/var/lib/jab-hub
Environment=HOME=/home/jabhub
Environment=NODE_ENV=production
Environment=PATH=/home/jabhub/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=OPENCLAW_CLI=/home/jabhub/.npm-global/bin/openclaw
ExecStart=/usr/bin/node /opt/jab-hub/scripts/evolution-openclaw-bridge.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jab-hub-bridge

# Give Docker/Evolution a moment after reboot
ExecStartPre=/bin/sleep 3

[Install]
WantedBy=multi-user.target
