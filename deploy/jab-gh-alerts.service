[Unit]
Description=FIE AI Ghana — saved-search WhatsApp alerts
After=network.target keyfinder-ghana.service

[Service]
Type=oneshot
User=jabhub
WorkingDirectory=/opt/keyfinder-ghana
EnvironmentFile=-/opt/keyfinder-ghana/.env
Environment=JAB_HUB_DATA_DIR=/var/lib/keyfinder-ghana
ExecStart=/usr/bin/node /opt/keyfinder-ghana/scripts/re-saved-search-alerts.mjs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
