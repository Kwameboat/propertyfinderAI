[Unit]
Description=Property Finder Puppeteer scrape → Supabase (daily)
After=network-online.target

[Service]
Type=oneshot
User=jabhub
Group=jabhub
WorkingDirectory=/opt/jab-hub
EnvironmentFile=/opt/jab-hub/.env
Environment=HOME=/home/jabhub
Environment=NODE_ENV=production
# Exits 0 when JAB_RE_PUPPETEER_SCRAPE is not 1 (timer stays healthy while disabled)
ExecStart=/usr/bin/node /opt/jab-hub/scripts/re-puppeteer-ingest.mjs --all --systemd
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jab-re-puppeteer-scrape

[Install]
WantedBy=multi-user.target
